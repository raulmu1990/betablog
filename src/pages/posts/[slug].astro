---
import { marked } from 'marked';
import Layout from '@layouts/Layout.astro';
import Badge from '@components/Badge.astro';
import { Icon } from 'astro-icon/components';
import { getPost, strapiUrl } from '@lib/strapi';

const { slug } = Astro.params;

const { post } = await getPost(slug || '');

if (!post) {
    return Astro.redirect('/404');
}

const htmlContent = marked.parse(post.content);
---

<Layout title={post.title}>
    <section class="w-full max-w-4xl mx-auto px-4 md:px-6 space-y-8 my-12">
        <header class="space-y-4">
            <Badge>{post.category}</Badge>
            <h1 class="text-4xl font-bold capitalize leading-tight text-body dark:text-body-dark">{post.title}</h1>
            <div class="flex gap-5 items-center">
                <div class="flex items-center gap-2">
                    <img class="rounded-full" src={`${strapiUrl}${post.author.avatar.url}`} loading="eager" alt="Author profile" width={40} height={40} />
                    <p class="capitalize font-medium text-body/75 dark:text-body-dark/50">{post.author.firstName} {post.author.lastName}</p>
                </div>
                <div class="w-[2px] h-6 relative after:content-[''] after:absolute after:w-full after:h-full after:top-0 after:left-0 after:bg-body/75 dark:after:bg-body-dark/50"></div>
                <div class="flex gap-2 items-center">
                    <span class="w-fit">
                        <Icon name="calendar" class="size-4 text-body/75 dark:text-body-dark/50" />
                    </span>
                    <time datetime="2023-10-12" class="text-body/75 dark:text-body-dark/50 font-medium">
                        {post.publishDate}
                    </time>
                </div>
            </div>
        </header>
        <div>
            <img transition:name={post.documentId} class="w-full h-[50vh] rounded-2xl object-cover" src={`${strapiUrl}${post.featuredImage.url}`} alt={post.title} loading="eager" >
        </div>
        <div class="w-full prose prose-lg dark:prose-invert max-w-none" set:html={htmlContent} />
    </section>
</Layout>