---
import { strapiUrl } from '@lib/strapi';
import PostCard from '@components/PostCard.astro';
import Link from '@components/Link.astro';
import type { Post } from '@interfaces/posts';

interface Props {
    posts: Post[];
    title?: string;
    allPostsLink?: boolean;
}

const { posts, title, allPostsLink = false } = Astro.props;
---

<section class="py-20 space-y-8">
    <h2 class="text-2xl font-bold capitalize">{title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
            posts.map((post) => (

                <PostCard 
                    id={post?.documentId}
                    imageSrc={`${strapiUrl}${post?.featuredImage?.formats?.small?.url || post?.featuredImage?.url}`}
                    avatar={`${strapiUrl}${post?.author?.avatar?.url}`}
                    title={post?.title}
                    category={post?.category}
                    dateOfPublish={post?.publishDate}
                    author={`${post?.author?.firstName} ${post?.author?.lastName}`}
                    authorSlug={post?.author?.slug}
                    slug={post?.slug}
                />
            ))
        }
    </div>
    {posts.length === 0 && (
        <p class="bg-secondary-100 dark:bg-secondary-100-dark p-4 rounded border border-body dark:border-body-dark text-body dark:text-body-dark text-center">
            No posts were found.
        </p>
    )}
    <div class="flex justify-center">
        {
            allPostsLink && (
                <Link href="/posts" isButton={true}>View all posts</Link>
            )
        }
    </div>
</section>