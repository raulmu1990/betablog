---
import { getAllPosts, strapiUrl } from '@lib/strapi';
import PostCard from '@components/PostCard.astro';

interface Props {
    title?: string;
}

const { title } = Astro.props;

const { posts } = await getAllPosts();
---

<section class="py-20 space-y-8">
    <h2 class="text-2xl font-bold capitalize">{title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
            posts.map((post) => (

                <PostCard 
                    id={post?.documentId}
                    imageSrc={`${strapiUrl}${post?.featuredImage?.url}`}
                    avatar={`${strapiUrl}${post?.author?.avatar?.url}`}
                    title={post?.title}
                    category={post?.category}
                    dateOfPublish={post?.publishDate}
                    author={`${post?.author?.firstName} ${post?.author?.lastName}`}
                    slug={post?.slug}
                />
            ))
        }
    </div>
</section>