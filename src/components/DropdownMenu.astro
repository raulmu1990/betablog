---
import { Icon } from 'astro-icon/components';

import SearchInput from "./SearchInput.astro";
import DarkButtonToggle from "./DarkButtonToggle.astro";
import DropdownButton from './DropdownButton.astro';
import Link from './Link.astro';
---

<div class="block md:hidden">
    <label class="peer p-3">
        <Icon class="size-6" name="menu" />
        <input hidden role="switch" type="checkbox" id="mobile-menu-button">
    </label>
    <div class="fixed top-0 right-0 z-10 flex flex-col gap-3 p-4 translate-x-full peer-has-checked:translate-x-0 w-full h-screen bg-light-background dark:bg-background-dark transition-transform duration-300 ease-in-out">
        <button class="block" onclick="document.getElementById('mobile-menu-button').checked = false">Close</button>
        <DarkButtonToggle />
        <SearchInput />
        <DropdownButton>Categories</DropdownButton>
        <Link href="/posts">All posts</Link>
    </div>
</div>