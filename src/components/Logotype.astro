---
import type { Favicon } from '@interfaces/global';

interface Props {
    logoLightTheme: Favicon;
    logoDarkTheme: Favicon;
}

const { logoLightTheme, logoDarkTheme } = Astro.props;
---
<a href="/" class="block">
    <img class="block dark:hidden" src={logoLightTheme.url} alt="Betablog logo" width={logoLightTheme.width} height={logoLightTheme.height} loading="eager" />
    <img class="hidden dark:block" src={logoDarkTheme.url} alt="Betablog logo" width={logoDarkTheme.width} height={logoDarkTheme.height} loading="eager" />
</a>