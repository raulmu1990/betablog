---
import type LogoIcon from '@interfaces/logoIcon';
import { strapiUrl } from '@lib/strapi';

interface Props {
    logoLightTheme: LogoIcon;
    logoDarkTheme: LogoIcon;
}

const { logoLightTheme, logoDarkTheme } = Astro.props;
---
<a href="/" class="block">
    <img class="block dark:hidden" src={`${strapiUrl}${logoLightTheme.url}`} alt="Betablog logo" width={logoLightTheme.width} height={logoLightTheme.height} loading="eager" />
    <img class="hidden dark:block" src={`${strapiUrl}${logoDarkTheme.url}`} alt="Betablog logo" width={logoDarkTheme.width} height={logoDarkTheme.height} loading="eager" />
</a>