---
import LinkFooter from '@components/LinkFooter.astro';
import NewsletterForm from '@components/NewsletterForm.astro';
import ColumnLinks from '@components/ColumnLinks.astro';

const { footer } = Astro.props;
---

<footer class="w-full pt-16 px-4 md:px-6 lg:px-12 xl:px-0 space-y-16 bg-secondary dark:bg-secondary-dark border-t border-secondary-100 dark:border-secondary-100-dark">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[3fr_5fr_4fr] gap-12 lg:gap-5">
        <div class="order-last lg:order-first space-y-6">
            <p class="space-y-3 text-body/75 dark:text-body-dark/50">
                <strong class="block font-semibold text-lg text-body dark:text-body-dark">About</strong>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, 
                sed do eiusmod tempor incididunt ut labore et dolore magna 
                aliqua. Ut enim ad minim veniam
            </p>
            <ul class="space-y-1">
                <li class="text-body dark:text-body-dark">
                    <strong class="font-semibold">Email:</strong>
                    <a class="text-body/75 dark:text-body-dark/50 hover:text-primary hover:underline" href="mailto:raul@betablog.com">raul@betablog.com</a>
                </li>
                <li class="text-body dark:text-body-dark">
                    <strong class="font-semibold">Phone:</strong>
                    <a class="text-body/75 dark:text-body-dark/50 hover:text-primary hover:underline" href="tel:+8801234567890">+880 123 456 789</a>
                </li>
            </ul>
        </div>
        <div class="flex gap-16 justify-start lg:justify-center">
            <ColumnLinks title="Quick links">
                {
                    footer.footerLinks.map((link: any) => (
                        <LinkFooter href={link.href} label={link.label} isExternal={link.isExternalLink} />
                    ))
                }
            </ColumnLinks>
            <ColumnLinks title="Categories">
                {
                    footer.categoriesLinks.map((link: any) => (
                        <LinkFooter href={link.href} label={link.label} />
                    ))
                }
            </ColumnLinks>
        </div>
        <NewsletterForm />
    </div>
    <div class="max-w-7xl mx-auto py-8 flex flex-col gap-3 md:flex-row items-center justify-start sm:justify-between border-t-2 border-secondary-100 dark:border-secondary-100-dark">
        <div class="space-y-1">
            <strong class="block text-center sm:text-start font-normal text-body dark:text-body-dark text-xl">
                Beta<span class="font-bold">BLog</span>
            </strong>
            <p class="text-body/75 dark:text-body-dark/50">Copyright © BetaBlog {new Date().getFullYear()}. All rights reserved.</p>
        </div>
        <ul class="flex gap-4">
            <li><a href="#" class="text-body/75 dark:text-body-dark/50 hover:text-primary hover:underline">Terms of use</a></li>
            <li><a href="#" class="text-body/75 dark:text-body-dark/50 hover:text-primary hover:underline">Privacy policy</a></li>
        </ul>
    </div>
</footer>