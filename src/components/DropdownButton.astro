---
import { Icon } from 'astro-icon/components';
import Link from '@components/Link.astro';
import type { Link as NavLink } from '@interfaces/global';

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<div class="block space-y-2">
  <label class="peer flex items-center justify-between px-4 py-2 rounded cursor-pointer has-checked:[&>span]:text-primary has-checked:bg-primary/10">
    <input class="hidden" type="checkbox" />

    <span class="font-medium text-body dark:text-body-dark">
      <slot />
    </span>
    <Icon name="chevron" class="size-5 text-body dark:text-body-dark has-checked:text-primary" />
  </label>

  <div class="peer-has-checked:flex flex-col gap-2 pl-4 hidden">
    {
      links.map((link) => (
        <Link href={link.href} isExternal={link.isExternalLink}>{link.label}</Link>
      ))
    }
  </div>
</div>