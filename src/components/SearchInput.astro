---
import { Icon } from 'astro-icon/components';
---

<form role="search">
    <label class="flex items-center md:inline-flex border border-body/25 dark:border-body-dark/25 bg-secondary-100 dark:bg-secondary-100-dark pl-2 md:pl-4 pr-2 py-2 rounded">
        <input 
            id="search-input" 
            type="search" 
            placeholder="Search..." 
            aria-label="Search posts" 
            class="flex-1 md:w-[180px] text-sm text-body dark:text-body-dark focus:border-none outline-none"
        />
        <span class="w-fit">
            <Icon 
                name="magnifying-glass" 
                class="stroke-body size-4"
            />
        </span>
    </label>
</form>