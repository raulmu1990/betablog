---
    interface Props {
        href: string;
        isExternal: boolean;
    }

    const { href, isExternal } = Astro.props;
---

<a 
    href={href} 
    target={isExternal ? '_blank' : '_self'}
    class="inline-block text-body dark:text-body-dark font-medium px-4 py-2 rounded hover:bg-primary/10 hover:text-primary transition-colors duration-100">
    <slot />
</a>