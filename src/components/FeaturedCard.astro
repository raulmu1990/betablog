---
import { Icon } from 'astro-icon/components';
import { strapiUrl } from '@lib/strapi';
import type { Post } from '@interfaces/posts';

interface Props {
    featuredPost: Post;
}

const { featuredPost: post } = Astro.props;
---

<img
    class="w-full h-[50vh] lg:h-[65vh] object-cover rounded-xl" 
    src={`${strapiUrl}${post?.featuredImage?.url}`} 
    alt={post?.title} 
/>

<a href={`/posts/${post?.category?.slug}/${post?.slug}`} class="group block bg-white dark:bg-background-dark dark:border dark:border-secondary-100-dark relative z-1 rounded-2xl p-6 md:p-10 w-[90%] md:w-[65%] mt-[-50%] sm:mt-[-20%] ml-4 lg:ml-12 xl:ml-16 shadow-xl dark:shadow-none space-y-6 hover:shadow-2xl hover:shadow-primary/20 hover:scale-105 transition-all duration-300 ease-in">
    <header class="space-y-4">
        <div class="bg-primary rounded p-2 text-sm text-white font-medium w-fit" >{post?.category.name}</div>
        <h1 class="capitalize text-body dark:text-body-dark font-semibold text-2xl leading-tight md:text-3xl lg:text-4xl xl:text-5xl">
            {post?.title}
        </h1>
    </header>

    <footer class="flex gap-5 items-center">
        <div class="flex items-center gap-2">
            <img class="rounded-full" src={`${strapiUrl}${post?.author?.avatar?.url}`} loading="eager" alt="Author profile" width={40} height={40} />
            <p class="capitalize font-medium text-body/75 dark:text-body-dark/50">{post?.author?.firstName} {post?.author?.lastName}</p>
        </div>
        <div class="w-[2px] h-6 relative after:content-[''] after:absolute after:w-full after:h-full after:top-0 after:left-0 after:bg-body/75 dark:after:bg-body-dark/50"></div>
        <div class="flex gap-2 items-center">
            <span class="w-fit">
                <Icon name="calendar" class="size-4 text-body/75 dark:text-body-dark/50" />
            </span>
            <time datetime={post?.publishDate.toString()} class="text-body/75 dark:text-body-dark/50 font-medium">
                {post?.publishDate}
            </time>
        </div>
    </footer>

    <div class="inline-flex opacity-0 group-hover:opacity-100 group-hover:scale-105 group-hover:text-primary absolute bottom-3 right-3 p-3 py-1.5 gap-2 items-center border rounded-full font-medium text-sm transition-all duration-300 ease-in">
        Go to post
        <span>
            <Icon name="arrow-up-right" class="size-4" />
        </span>
    </div>
</a>